<?xml version="1.0" encoding="utf-8"?>
<!-- Nuevo Proyecto V2: Pantalla de detalle ampliado de un modelo consultado en la API (Hito 2) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detalle del modelo"
            android:textColor="#80CBC4"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Imagen de cabecera acorde con la estética de appCars -->
        <ImageView
            android:id="@+id/imagenDetalleModeloApi"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:scaleType="centerCrop"
            android:src="@drawable/coche_deportivo"
            android:background="#1E1E1E"
            android:contentDescription="Imagen del vehículo consultado"
            android:layout_marginBottom="18dp"/>

        <!-- Ficha técnica con toda la información traída de la API y guardada en Room -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#242424"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/textoDetalleNombreModelo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Modelo: Ibiza"
                android:textColor="#80CBC4"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/textoDetalleMarcaModelo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fabricante / Marca: SEAT"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:layout_marginTop="8dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#383838"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/textoDetalleModelId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ID oficial del modelo (NHTSA): 2043"
                android:textColor="#CCCCCC"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/textoDetalleMakeId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ID oficial del fabricante: 448"
                android:textColor="#CCCCCC"
                android:textSize="15sp"
                android:layout_marginTop="6dp"/>

            <TextView
                android:id="@+id/textoDetalleFechaCache"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Guardado en caché Room: 20/11/2026 09:00"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:layout_marginTop="6dp"/>

            <TextView
                android:id="@+id/textoDetalleFuenteApi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fuente: API pública NHTSA VPIC (disponible sin conexión)"
                android:textColor="#80CBC4"
                android:textSize="13sp"
                android:layout_marginTop="10dp"/>
        </LinearLayout>

        <!-- Mejora propia: botón para marcar o desmarcar este modelo como favorito en Room -->
        <Button
            android:id="@+id/botonDetalleFavorito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="☆ Guardar en favoritos"
            android:backgroundTint="#242424"
            android:textColor="#FFD54F"
            android:layout_marginBottom="10dp"/>

        <!-- Mejora propia: integra la API con nuestra app pasando este modelo al formulario de mantenimiento -->
        <Button
            android:id="@+id/botonUsarEnMantenimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔧 Registrar mantenimiento para este modelo"
            android:backgroundTint="#80CBC4"
            android:textColor="#102020"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/botonVolverDetalleModelo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver al catálogo"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"/>

    </LinearLayout>
</ScrollView>
